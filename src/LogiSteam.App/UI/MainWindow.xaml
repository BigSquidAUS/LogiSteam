<Window x:Class="LogiSteam.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LogiSteam.UI"
        xmlns:dash="clr-namespace:LogiSteam.Common.Dashboard;assembly=LogiSteam.Common"
        xmlns:tray="clr-namespace:LogiSteam.Common.Tray;assembly=LogiSteam.Common"
        Title="LogiSteam"
        Width="460" Height="780"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/LogiSteam;component/Assets/LogiSteam.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:LevelToBrushConverter x:Key="LevelBrush" />
        <ui:LevelToGlyphConverter x:Key="LevelGlyph" />
        <ui:VisibleWhenConverter x:Key="VisibleWhen" />

        <!-- Step status icons -->
        <DataTemplate x:Key="StepDone">
            <Grid Width="22" Height="22">
                <Ellipse Fill="{StaticResource Good}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnAccent}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StepProblem">
            <Grid Width="22" Height="22">
                <Ellipse Fill="{StaticResource Warn}" />
                <TextBlock Text="!" FontSize="14" FontWeight="Bold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StepPending">
            <Grid Width="22" Height="22">
                <Ellipse Stroke="{StaticResource StrokeStrong}" StrokeThickness="2" Margin="1" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StepActive">
            <Grid Width="22" Height="22">
                <Ellipse Stroke="{StaticResource Stroke}" StrokeThickness="2.5" Margin="1" />
                <Path Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 11,2.25 A 8.75,8.75 0 0 1 19.75,11" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Laid out at the 460x780 design size, then scaled as a whole to fit smaller screens (see FitToScreen). -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="120" Height="120">
                        <Ellipse Width="120" Height="120" Stroke="{StaticResource Accent}" StrokeThickness="14" />
                        <Line X1="60" Y1="60" X2="10" Y2="60" Stroke="{StaticResource Accent}" StrokeThickness="14" />
                        <Line X1="60" Y1="60" X2="110" Y2="60" Stroke="{StaticResource Accent}" StrokeThickness="14" />
                        <Line X1="60" Y1="60" X2="60" Y2="110" Stroke="{StaticResource Accent}" StrokeThickness="14" />
                        <Ellipse Canvas.Left="44" Canvas.Top="44" Width="32" Height="32" Fill="{StaticResource Accent}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="LogiSteam" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" Margin="10,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close - LogiSteam keeps running in the tray" />
            </StackPanel>
        </Grid>

        <!-- Dashboard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding IsChoosingRole, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <StackPanel Margin="24,6,24,18">

                <!-- Wheel PC / Game PC switch -->
                <Border HorizontalAlignment="Center" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="12" Padding="3">
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSwitch}">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Role" MinWidth="120"
                                     IsChecked="{Binding IsWheelRole, Mode=TwoWay}"
                                     ToolTip="Choose this on the PC your wheel is plugged into">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource WheelGeometry}" Stretch="Uniform" Width="15" Height="15" StrokeThickness="2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Wheel PC" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Role" MinWidth="120"
                                     IsChecked="{Binding IsGameRole, Mode=TwoWay}"
                                     ToolTip="Choose this on the PC that runs your games">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE977;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Game PC" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding RoleCaption}" Foreground="{StaticResource TextMuted}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />

                <!-- Status emblem -->
                <Grid Height="176" Margin="0,8,0,0">
                    <Ellipse x:Name="Glow" Width="150" Height="150" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" Opacity="0.30">
                        <Ellipse.Effect>
                            <BlurEffect Radius="70" />
                        </Ellipse.Effect>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static tray:TrayStatusLevel.Idle}">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="Pulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.14" To="0.38"
                                                                     Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <Ellipse Width="156" Height="156" Fill="{StaticResource Surface}" Stroke="{StaticResource Stroke}" StrokeThickness="1" />
                    <Ellipse Width="156" Height="156" Stroke="{Binding Level, Converter={StaticResource LevelBrush}}" StrokeThickness="1.5" Opacity="0.55" />

                    <Viewbox Width="92" Height="92">
                        <Canvas Width="120" Height="120">
                            <Ellipse Width="120" Height="120" Stroke="{Binding Level, Converter={StaticResource LevelBrush}}" StrokeThickness="11" />
                            <Line X1="60" Y1="60" X2="9" Y2="60" Stroke="{Binding Level, Converter={StaticResource LevelBrush}}" StrokeThickness="11" />
                            <Line X1="60" Y1="60" X2="111" Y2="60" Stroke="{Binding Level, Converter={StaticResource LevelBrush}}" StrokeThickness="11" />
                            <Line X1="60" Y1="60" X2="60" Y2="111" Stroke="{Binding Level, Converter={StaticResource LevelBrush}}" StrokeThickness="11" />
                            <Ellipse Canvas.Left="45" Canvas.Top="45" Width="30" Height="30" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                        </Canvas>
                    </Viewbox>

                    <!-- Badge -->
                    <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="112,112,0,0">
                        <Ellipse Fill="{Binding Level, Converter={StaticResource LevelBrush}}" Stroke="{StaticResource Surface}" StrokeThickness="4" />
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Level, Converter={StaticResource LevelGlyph}}"
                                   FontSize="15" Foreground="{StaticResource OnAccent}" />
                    </Grid>
                </Grid>

                <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="13.5" LineHeight="20"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="12,8,12,0" />

                <!-- Warnings -->
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dash:DashboardWarning}">
                            <Border Background="{StaticResource WarnSurface}" BorderBrush="{StaticResource WarnStroke}" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Foreground="{StaticResource Warn}"
                                               VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Background="{StaticResource Warn}"
                                            Content="{Binding ActionLabel}" Click="OnWarningAction" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding ActionLabel, Converter={StaticResource VisibleWhen}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Connection checklist -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,5">
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:StepViewModel}">
                                <StackPanel>
                                    <Grid Margin="0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource StepPending}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Done}">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource StepDone}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Active}">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource StepActive}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Problem}">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource StepProblem}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Pending}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Detail}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Pending}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static dash:StepState.Problem}">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource Stroke}"
                                               Visibility="{Binding IsLast, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Advanced -->
                <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource DisclosureToggle}" Content="Advanced"
                              HorizontalAlignment="Center" Margin="0,10,0,0" />
                <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="4"
                        Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemsSource="{Binding AdvancedActions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Click="OnAdvancedAction">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Style="{StaticResource LinkButton}" Click="OnDonate" HorizontalAlignment="Center" Margin="0,10,0,0"
                        ToolTip="LogiSteam is free. If it got your wheel working, you can say thanks with a donation (opens PayPal in your browser).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEB52;" FontSize="12" Foreground="#F26D8F" Margin="0,1,7,0" />
                        <TextBlock Text="Donate" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- First run: which PC is this? -->
        <StackPanel Grid.Row="1" Margin="28,0,28,44" VerticalAlignment="Center"
                    Visibility="{Binding IsChoosingRole, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="Welcome to LogiSteam" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13.5" LineHeight="20" TextAlignment="Center" TextWrapping="Wrap" Margin="6,10,6,0"
                       Text="Use your Logitech racing wheel over Steam Remote Play as if it were plugged straight into your Game PC. Install LogiSteam on both PCs, then tell each one what it is." />
            <TextBlock Text="Which PC is this?" FontWeight="SemiBold" FontSize="15" Margin="2,34,0,12" />

            <Button Style="{StaticResource CardButton}" Click="OnWheelRoleClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource SurfaceRaised}" Margin="0,0,16,0">
                        <Path Data="{StaticResource WheelGeometry}" Stretch="Uniform" Width="22" Height="22" StrokeThickness="2.6"
                              Stroke="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Wheel PC" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="My racing wheel is plugged into this PC." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding DetectedWheelHint, Converter={StaticResource VisibleWhen}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DetectedWheelHint}" Foreground="{StaticResource Good}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource CardButton}" Click="OnGameRoleClick" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource SurfaceRaised}" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE977;" FontSize="20" Foreground="{StaticResource Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Game PC" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="This PC runs Steam and my games." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </Grid>
            </Button>

            <TextBlock Text="You can change this any time with the switch at the top of the window." Foreground="{StaticResource TextMuted}"
                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
            <Button Style="{StaticResource LinkButton}" Click="OnDonate" HorizontalAlignment="Center" Margin="0,22,0,0"
                    ToolTip="LogiSteam is free. If it got your wheel working, you can say thanks with a donation (opens PayPal in your browser).">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB52;" FontSize="12" Foreground="#F26D8F" Margin="0,1,7,0" />
                    <TextBlock Text="Donate" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
