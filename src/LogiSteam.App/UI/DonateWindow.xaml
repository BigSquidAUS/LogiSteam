<Window x:Class="LogiSteam.UI.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support LogiSteam"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True" />

        <StackPanel Margin="32,38,32,28">
            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                <Ellipse Width="60" Height="60" Fill="#F26D8F" Opacity="0.35">
                    <Ellipse.Effect>
                        <BlurEffect Radius="34" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="68" Height="68" Fill="{StaticResource Surface}" Stroke="{StaticResource Stroke}" StrokeThickness="1" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xEB52;" FontSize="28" Foreground="#F26D8F" Margin="0,2,0,0" />
            </Grid>

            <TextBlock Text="Enjoying LogiSteam?" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                       TextAlignment="Center" Margin="0,18,0,0" />

            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13.5" LineHeight="21" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0">
                Hi, I'm Ben. I build LogiSteam in my spare time and give it away for free, with no ads and nothing locked away.
            </TextBlock>
            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13.5" LineHeight="21" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0">
                If it has made your racing setup better, a small donation genuinely helps. It covers the time and the hardware it takes to keep LogiSteam working with new wheels and Windows updates, and it's the best motivation there is to keep improving it.
            </TextBlock>
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" LineHeight="18" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0">
                No pressure either way. LogiSteam will always be free, and you'll only see this once every 50 launches.
            </TextBlock>

            <Button Style="{StaticResource PrimaryButton}" Background="#F26D8F" Padding="16,11" FontSize="14" Margin="0,24,0,0"
                    IsDefault="True" Click="OnDonate">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB52;" FontSize="13" Margin="0,1,9,0" />
                    <TextBlock Text="Donate with PayPal" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Content="Maybe later" Padding="16,10" Margin="0,10,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
