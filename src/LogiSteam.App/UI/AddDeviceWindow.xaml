<Window x:Class="LogiSteam.UI.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add another USB device"
        Width="460" Height="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Step 1: pick a device -->
        <Grid x:Name="PickPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" IsCancel="True" />

            <StackPanel Grid.Row="1" Margin="24,0,24,16">
                <TextBlock Text="Add another USB device" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"
                           Text="Choose a device plugged into this PC to share with your Game PC alongside the wheel: pedals, a shifter, a handbrake, a button box, a Stream Deck or a joystick." />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0" Padding="4">
                <Grid>
                    <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnDeviceDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding HardwareIdText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource WarnSurface}" BorderBrush="{StaticResource WarnStroke}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" TextWrapping="Wrap" Margin="24" TextAlignment="Center" LineHeight="19"
                               Text="No other devices to add. Plug the device into this PC and choose Refresh." />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="24,12,24,22">
                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                           Text="Storage drives, network and Bluetooth adapters and USB hubs aren't listed, because sharing them would break this PC or the connection." />
                <Grid Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Refresh" HorizontalAlignment="Left" Click="OnRefresh" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
                        <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Add device" IsDefault="True" IsEnabled="False" Click="OnAdd" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Step 2 (only for flagged devices): are you sure? -->
        <Grid x:Name="ConfirmPanel" Visibility="Collapsed" Background="{StaticResource WindowBackground}">
            <StackPanel Margin="32,0" VerticalAlignment="Center">
                <Grid Width="68" Height="68" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource WarnSurface}" Stroke="{StaticResource WarnStroke}" StrokeThickness="1" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="28" Foreground="{StaticResource Warn}" />
                </Grid>
                <TextBlock x:Name="ConfirmTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0" />
                <TextBlock x:Name="ConfirmText" Foreground="{StaticResource TextSecondary}" FontSize="13.5" LineHeight="21"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="ConfirmEscape" Foreground="{StaticResource TextMuted}" FontSize="12" LineHeight="18"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource Warn}" Content="Add it anyway" Padding="16,10" Margin="0,24,0,0" Click="OnConfirm" />
                <Button Style="{StaticResource GhostButton}" Content="Go back" Padding="16,10" Margin="0,10,0,0" Click="OnBack" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
